{
  "name": "@teire/engine",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./llm": "./src/llm/index.ts",
    "./constants": "./src/constants.ts",
    "./catalog": "./src/catalog/index.ts",
    "./contract": "./src/contract.ts",
    "./verify": "./src/verify/cloudflare.ts",
    "./inventory": "./src/inventory/index.ts",
    "./registry": "./src/registry/index.ts",
    "./net": "./src/net/fetch.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "smoke": "tsx --env-file=../../.env.local scripts/smoke-tokenfactory.ts",
    "catalog:sync": "tsx scripts/catalog-sync.ts",
    "compare-models": "tsx --env-file=../../.env.local scripts/compare-models.ts",
    "test": "vitest run",
    "catalog:validate": "tsx scripts/catalog-validate.ts"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "3.0.77",
    "@yarnpkg/parsers": "3.1.0",
    "ai": "7.0.150",
    "jsonc-parser": "3.3.1",
    "semver": "7.8.5",
    "smol-toml": "1.9.1",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/semver": "7.8.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.4"
  }
}
