{
  "theme": "base",
  "themeVariables": {
    "fontFamily": "Geist, Inter, Helvetica Neue, Arial, sans-serif",
    "fontSize": "16px",
    "background": "#f5f5ef",
    "primaryColor": "#ffffff",
    "primaryTextColor": "#14140f",
    "primaryBorderColor": "#d2d2c8",
    "secondaryColor": "#efefe7",
    "secondaryTextColor": "#14140f",
    "secondaryBorderColor": "#d2d2c8",
    "tertiaryColor": "#f5f5ef",
    "tertiaryTextColor": "#14140f",
    "tertiaryBorderColor": "#e2e2d8",
    "clusterBkg": "#efefe7",
    "clusterBorder": "#e2e2d8",
    "lineColor": "#66665c",
    "textColor": "#14140f",
    "edgeLabelBackground": "#f5f5ef",
    "actorBkg": "#ffffff",
    "actorBorder": "#d2d2c8",
    "actorTextColor": "#14140f",
    "actorLineColor": "#e2e2d8",
    "signalColor": "#55554c",
    "signalTextColor": "#14140f",
    "labelBoxBkgColor": "#efefe7",
    "labelTextColor": "#14140f",
    "loopTextColor": "#55554c",
    "noteBkgColor": "#efefe7",
    "noteBorderColor": "#d2d2c8",
    "noteTextColor": "#14140f",
    "sequenceNumberColor": "#f5f5ef"
