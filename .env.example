# Copy to .env.local and fill in. Never commit real values.

# --- Nebius Token Factory (every LLM call) ---
TOKENFACTORY_API_KEY=
TOKENFACTORY_BASE_URL=https://api.tokenfactory.nebius.com/v1/
# Model IDs are read from /v1/models during setup and kept here, never hard-coded in logic.
TEIRE_MODEL_DRIVER=nvidia/nemotron-3-super-120b-a12b
TEIRE_MODEL_ESCALATION=nvidia/Nemotron-3-Ultra-550b-a55b
TEIRE_MODEL_FAST=nvidia/Nemotron-3_5-Lightning

# --- Token Factory Sandboxes (primary verifier) ---
NEBIUS_PROJECT_ID=

# --- Cloudflare Sandbox (fallback verifier, our teire-sandbox Worker) ---
CF_SANDBOX_URL=
CF_SANDBOX_TOKEN=

# --- Docs and search ---
CONTEXT7_API_KEY=
TAVILY_API_KEY=

# --- Database (Postgres on Coolify) ---
DATABASE_URL=
# PEM of the Coolify CA, for sslmode=verify-full from Vercel
DATABASE_CA_CERT=

# --- GitHub App ---
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Web ---
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
REVALIDATE_SECRET=

# --- Limits ---
TEIRE_DAILY_COST_CAP_USD=3
