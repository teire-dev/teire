# Copy to .env.local and fill in. Never commit real values.

# --- Nebius Token Factory (every LLM call) ---
TOKENFACTORY_API_KEY=
TOKENFACTORY_BASE_URL=https://api.tokenfactory.nebius.com/v1/
# Model IDs are read from /v1/models during setup and kept here, never hard-coded in logic.
TEIRE_MODEL_AGENT=nvidia/Nemotron-3-Ultra-550b-a55b
TEIRE_MODEL_READER=nvidia/Nemotron-3-Ultra-550b-a55b
TEIRE_MODEL_FAILOVER=nvidia/Nemotron-3.5-Super-VL

# --- Verification sandbox (apps/sandbox, deployed to Cloudflare Containers with wrangler) ---
# The Worker's URL, and the key it was given with `wrangler secret put TEIRE_SANDBOX_KEY`.
TEIRE_SANDBOX_URL=
TEIRE_SANDBOX_KEY=
# Optional: only probes Token Factory Sandboxes access; checks always run on Cloudflare Containers.
NEBIUS_PROJECT_ID=

# --- Docs and search ---
CONTEXT7_API_KEY=
TAVILY_API_KEY=

# --- Database ---
# postgres://user:password@host:port/teire — no sslmode in the URL (it would override the CA below).
# Locally: a Postgres 17 on localhost needs no CA. Deployed: TLS only, verified against the CA.
DATABASE_URL=
DATABASE_CA_CERT=

# --- GitHub App ---
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Web ---
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
REVALIDATE_SECRET=
# Where the worker links runs from PRs and comments, and asks the web app to refresh its cache.
TEIRE_WEB_URL=http://localhost:3000

# --- Limits ---
# Model spend over 24 hours before model work pauses (default 10; 0 turns the cap off).
TEIRE_DAILY_COST_CAP_USD=10

# The resolver service on the Coolify host (apps/resolver/host): dependabot-core's updater under gVisor.
# URL is the Coolify network's gateway address; the secret is in /etc/teire-resolver/env on the host.
TEIRE_RESOLVER_URL=
TEIRE_RESOLVER_SECRET=
# Ecosystems whose dependency files the updater decides (comma-separated: npm,pypi,go,cargo,rubygems,maven).
# For them a stop is final and an unreachable updater queues; the rest use Teire's own edits.
TEIRE_RESOLVER_ECOSYSTEMS=
# R2 package cache for Cloudflare runs (R21.11): set to `on` once the sandbox Worker has its
# `DEP_CACHE` R2 bucket (apps/sandbox/wrangler.jsonc); off, no run saves or restores a cache.
TEIRE_DEP_CACHE=
