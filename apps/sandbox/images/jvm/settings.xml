<?xml version="1.0" encoding="UTF-8"?>
<!-- Teire's sandbox (plan S08): Maven Central through Google's mirror of it. Central answers 403 to
     requests from the sandbox's Cloudflare egress (measured 2026-10-25); the mirror serves the same files. -->
<settings xmlns="http://maven.apache.org/SETTINGS/1.2.0">
  <mirrors>
    <mirror>
      <id>google-maven-central</id>
      <name>Google mirror of Maven Central</name>
      <url>https://maven-central.storage-download.googleapis.com/maven2/</url>
      <mirrorOf>central</mirrorOf>
    </mirror>
  </mirrors>
</settings>
