#!/usr/bin/env bash
# The Ruby sandbox's helper (plan S07, research ruby.md Jobs 7 and 8).
#   teire-ruby install          install phase: Ruby version, platform, gems, services, database
#   teire-ruby lock GEM [DAYS]  the upgrade: bundle lock --update GEM --conservative [--cooldown DAYS],
#                               then drop platforms the sandbox added (lockfile noise)
# Inputs come from the environment the worker's plan sets: TEIRE_RUBY_VERSION, TEIRE_SERVICES
# (postgres,redis,mysql), TEIRE_DB_SETUP (e.g. "bin/rails db:prepare"), DATABASE_URL, and
# TEIRE_RUBY_PREFER (the CI's Ruby when the repo pins none; the lockfile may overrule it).
set -uo pipefail
# exec() passes no image ENV; root is the only user in a throwaway sandbox.
export BUNDLE_SILENCE_ROOT_WARNING=1

LOCK="${BUNDLE_GEMFILE:-Gemfile}.lock"
[ -f "$LOCK" ] || LOCK=gems.locked

platforms() { awk '/^PLATFORMS$/{f=1;next} /^[^ ]/{f=0} f&&NF{print $1}' "$LOCK" 2>/dev/null; }

use_ruby() {
  local want="$1" have
  have="$(ruby -e 'print RUBY_VERSION')"
  [ "$have" = "$want" ] && return 0
  echo "teire-ruby: installing Ruby $want with rv (the image has $have)"
  rv ruby install "$want" || return 3
  local bin
  bin="$(find / -path /proc -prune -o -type f -path "*ruby-${want}*/bin/ruby" -print 2>/dev/null | head -1)"
  [ -n "$bin" ] || { echo "teire-ruby: rv installed nothing for $want"; return 3; }
  RUBY_BIN="$(dirname "$bin")"
  link_ruby
  ruby -v
}

# Later commands get a fixed PATH: put the switched Ruby's executables first in it. Run again after
# each install, since gems add executables (rspec, rake) that `bundle exec` looks up on PATH.
RUBY_BIN=""
link_ruby() {
  [ -n "$RUBY_BIN" ] || return 0
  for f in "$RUBY_BIN"/*; do ln -sf "$f" "/usr/local/sbin/$(basename "$f")"; done
  # bash remembers where it found ruby, gem and bundle before the switch.
  hash -r
}

bundled_with() { awk '/^BUNDLED WITH/ {getline; gsub(/[[:space:]]/, ""); print; exit}' "$LOCK" 2>/dev/null; }

# Put the lockfile's own BUNDLED WITH back: the image's Bundler rewrites it whenever it touches the
# lock, and that change would otherwise reach an upgrade's lockfile diff.
restore_bundled_with() {
  local want="$1"
  [ -n "$want" ] && [ -f "$LOCK" ] || return 0
  [ "$(bundled_with)" = "$want" ] || sed -i "/^BUNDLED WITH\$/{n;s/.*/   $want/}" "$LOCK"
}

# Token Factory's root filesystem (virtiofs) loses a file that mkmf writes while a compiler it started
# holds the same file open, so every native extension fails there with "Bad file descriptor - mkmf.log
# (Errno::EBADF)" (live walk on teire-dev/bristow; the same build passes on tmpfs). On that filesystem
# the gems are built on the VM's tmpfs and copied into place, where the checks read them.
bundle_install() {
  [ "$(awk '$2=="/"{print $3; exit}' /proc/mounts 2>/dev/null)" = virtiofs ] && [ -d /dev/shm ] \
    || { bundle install "$@"; return $?; }
  local dir shm=/dev/shm/teire-bundle status free used
  dir="$(ruby -rbundler -e 'print Bundler.bundle_path' 2>/dev/null)" || { bundle install "$@"; return $?; }
  # tmpfs is 2 GB on Token Factory's VMs: the bundle and 1 GB of headroom must fit, else the gems
  # install in place (native extensions may then fail there, and the run says so).
  free="$(df -Pk /dev/shm | awk 'NR==2 {print $4}')"
  used="$(du -sk "$dir" 2>/dev/null | awk '{print $1}')"
  if [ "$(( ${used:-0} + 1048576 ))" -gt "${free:-0}" ]; then
    echo "teire-ruby: /dev/shm has ${free:-0} KB free, too little to build gems there; installing in place"
    bundle install "$@"; return $?
  fi
  rm -rf "$shm" && mkdir -p "$dir" "$shm" && cp -a "$dir/." "$shm/" && rm -rf "$dir" && ln -s "$shm" "$dir" || return $?
  # The gems go back to the bundle path even when the install is stopped (its time limit sends TERM
  # ten seconds before KILL): a later step must not find a link into a tmpfs that isn't saved.
  restore() { [ -L "$dir" ] || return 0; rm "$dir" && mkdir -p "$dir" && cp -a "$shm/." "$dir/" && rm -rf "$shm"; }
  trap 'restore; exit 143' TERM INT
  bundle install "$@"; status=$?
  trap - TERM INT
  restore || return $?
  return "$status"
}

# Rubies tried when a repo pins none and the lockfile refuses the image's (newest first; rv builds).
FALLBACK_RUBIES="3.4.12 3.3.13 3.2.11"

# The Bundler the lockfile was written with (BUNDLED WITH), as Dependabot's helper follows it.
bundler_from_lock() {
  [ -f "$LOCK" ] || return 0
  local bv
  bv="$(bundled_with)"
  if [ -n "$bv" ] && ! gem list -i bundler -v "$bv" >/dev/null 2>&1; then
    # --force: a Ruby rv installed ships its own `bundle` binstub, which a plain install refuses to replace.
    gem install bundler -v "$bv" --no-document --force || return $?
  fi
}

start_postgres() {
  export PGDATA=/var/lib/teire/pg
  if ! pg_isready -q -h 127.0.0.1 2>/dev/null; then
    mkdir -p "$PGDATA" /var/run/postgresql && chown postgres "$PGDATA" /var/run/postgresql
    # exec() passes no locale: without -E the cluster is SQL_ASCII and Rails cannot create UTF-8 databases.
    su postgres -c "initdb -D $PGDATA -A trust -U postgres -E UTF8 --locale=C.UTF-8" >/dev/null || return 4
    su postgres -c "pg_ctl -D $PGDATA -l $PGDATA/server.log -o \"-c listen_addresses=localhost -k /var/run/postgresql\" -w start" >/dev/null || return 4
  fi
  # Trust authentication on localhost: the roles the app's config names, with any password.
  local user=""
  [[ "${DATABASE_URL:-}" =~ ^postgres(ql)?://([^:@/]+) ]] && user="${BASH_REMATCH[2]}"
  # teire: the OS user the checks run as, which libpq uses when database.yml names no user.
  for r in root rails teire $user; do
    psql -h 127.0.0.1 -U postgres -qc "CREATE ROLE \"$r\" LOGIN SUPERUSER" 2>/dev/null || true
  done
  echo "teire-ruby: postgres $(pg_ctl --version | awk "{print \$3}") on 127.0.0.1:5432"
}

start_redis() {
  redis-cli ping >/dev/null 2>&1 || redis-server --daemonize yes --bind 127.0.0.1 >/dev/null || return 4
  echo "teire-ruby: redis on 127.0.0.1:6379"
}

start_mysql() {
  if ! mariadb-admin ping >/dev/null 2>&1; then
    mariadb-install-db --user=mysql >/dev/null 2>&1
    mkdir -p /run/mysqld && chown mysql /run/mysqld
    (mariadbd-safe --user=mysql --bind-address=127.0.0.1 >/dev/null 2>&1 &)
    for _ in $(seq 1 30); do mariadb-admin ping >/dev/null 2>&1 && break; sleep 1; done
  fi
  mariadb -e "ALTER USER 'root'@'localhost' IDENTIFIED VIA mysql_native_password USING PASSWORD(''); CREATE USER IF NOT EXISTS 'root'@'127.0.0.1'; GRANT ALL ON *.* TO 'root'@'127.0.0.1'; FLUSH PRIVILEGES;" || return 4
  echo "teire-ruby: mariadb on 127.0.0.1:3306"
}

case "${1:-}" in
  install)
    if [ -n "${TEIRE_RUBY_VERSION:-}" ]; then
      use_ruby "$TEIRE_RUBY_VERSION" || exit $?
    elif [ -n "${TEIRE_RUBY_PREFER:-}" ]; then
      # The Ruby the repo's CI tests on (no exact pin): preferred, and the lockfile may still overrule it.
      echo "teire-ruby: the repo's CI tests on Ruby ${TEIRE_RUBY_PREFER%.*}; using $TEIRE_RUBY_PREFER"
      use_ruby "$TEIRE_RUBY_PREFER" || exit $?
    fi
    locked_bundler="$(bundled_with)"
    # A frozen install fails when the lockfile has neither `ruby` nor this platform (research gotcha 2).
    # Bundler before 2.5 also refuses `bundle lock` itself while frozen, so it is unfrozen for this step.
    if [ -f "$LOCK" ] && ! platforms | grep -qE '^(ruby|x86_64-linux)'; then
      BUNDLE_FROZEN=false bundle lock --add-platform x86_64-linux || exit $?
      restore_bundled_with "$locked_bundler"
    fi
    bundler_from_lock || exit $?
    # With no pin, the image's Ruby is a guess. When a locked gem refuses it ("minitest-5.20.0
    # requires ruby version < 4.0, >= 2.6, which is incompatible with the current version"), the
    # lockfile has said which Rubies it was resolved for: retry on the newest provided one it accepts.
    out="$(bundle_install --jobs 4 2>&1)"; status=$?
    echo "$out"
    link_ruby
    if [ "$status" -ne 0 ]; then
      req="$(tr '\n' ' ' <<<"$out" | grep -oE 'requires ruby version [<>=~!]+ ?[0-9][0-9.]*(, [<>=~!]+ ?[0-9][0-9.]*)*' | head -1 | sed 's/^requires ruby version //')"
      [ -z "${TEIRE_RUBY_VERSION:-}" ] && [ -n "$req" ] || exit "$status"
      pick=""
      for v in $FALLBACK_RUBIES; do
        if ruby -e 'exit Gem::Requirement.new(*ARGV[0].split(", ")).satisfied_by?(Gem::Version.new(ARGV[1]))' "$req" "$v"; then
          pick="$v"; break
        fi
      done
      [ -n "$pick" ] || { echo "teire-ruby: no provided Ruby satisfies $req"; exit "$status"; }
      echo "teire-ruby: the lockfile needs Ruby $req; retrying on Ruby $pick"
      use_ruby "$pick" || exit $?
      bundler_from_lock || exit $?
      bundle_install --jobs 4 || exit $?
      link_ruby
    fi
    for s in ${TEIRE_SERVICES:+${TEIRE_SERVICES//,/ }}; do "start_$s" || exit $?; done
    if [ -n "${TEIRE_DB_SETUP:-}" ]; then
      echo "teire-ruby: $TEIRE_DB_SETUP"
      bash -c "$TEIRE_DB_SETUP" || exit $?
    fi
    ;;
  lock)
    gem="${2:?gem}"
    [[ "$gem" =~ ^[A-Za-z0-9_.-]+$ ]] || { echo "teire-ruby: bad gem name"; exit 2; }
    before="$(platforms)"
    locked_bundler="$(bundled_with)"
    args=(lock --update "$gem" --conservative)
    [ -n "${3:-}" ] && args+=(--cooldown "$3")
    bundle "${args[@]}" || exit $?
    for p in $(platforms); do
      grep -qxF "$p" <<<"$before" || bundle lock --remove-platform "$p" || exit $?
    done
    # The upgrade moves one gem, not Bundler (unless Bundler is the gem being upgraded).
    [ "$gem" = bundler ] || restore_bundled_with "$locked_bundler"
    ;;
  *)
    echo "usage: teire-ruby install | lock GEM [COOLDOWN_DAYS]"; exit 2 ;;
esac
