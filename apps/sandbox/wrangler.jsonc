{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "teire-sandbox",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-20",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // Durable Object requests that drive long installs need more than the 30 s default CPU budget.
  "limits": { "cpu_ms": 300000 },
  "containers": [
    {
      "class_name": "VerifySandbox",
      "scheduling_policy": "durable_object",
      // One image per toolchain set (plan D60): Node (S02a), Python (S03), Go (S05), Rust (S06), Ruby (S07); later stages add theirs.
      "images": {
        "node": { "dockerfile": "./images/node/Dockerfile" },
        "python": { "dockerfile": "./images/python/Dockerfile" },
        "go": { "dockerfile": "./images/go/Dockerfile" },
        "rust": { "dockerfile": "./images/rust/Dockerfile" },
        "ruby": { "dockerfile": "./images/ruby/Dockerfile" }
      }
    }
  ],
  "durable_objects": { "bindings": [{ "name": "SANDBOX", "class_name": "VerifySandbox" }] },
  "exports": { "VerifySandbox": { "type": "durable-object", "storage": "sqlite" } }
  // R2 dependency cache: add {"r2_buckets": [{"binding": "DEP_CACHE", "bucket_name": "teire-dep-cache"}]}
  // once R2 is enabled on the account (the DirectoryBackup routes need it).
}
