  "title": "Removes deprecated Payment Intents, Setup Intents, and Sources methods from Stripe.js",
  "summary": "Removes several deprecated methods from Stripe.js in favor of equivalent methods with clearer naming and improved functionality. The following methods have been removed and will throw an error if called:",
  "applicability": {
    "class": "breaks-on-upgrade",
    "fixedIn": [],
    "apiVersion": {
      "header": "Stripe-Version",
      "to": "2026-03-25.dahlia"
    },
    "announcedOn": "2026-03-25",
    "effectiveOn": null
  },
  "signatures": [],
  "replacement": null,
  "migrationNotes": [
    {
      "text": "If your integration uses any of the deprecated methods, you must update your code to use different methods, as in the following examples:",
      "sourceIndex": 0
    },
    {
      "text": "### Payment Intents API methods",
      "sourceIndex": 0
    },
    {
      "text": "Replace handleCardPayment with confirmCardPayment, which has a similar API signature and behavior.",
      "sourceIndex": 0
    },
    {
      "text": "javascript",
      "sourceIndex": 0
    },
    {
      "text": "// Before (deprecated)",
      "sourceIndex": 0
    },
    {
      "text": "stripe.handleCardPayment(clientSecret, cardElement);",
      "sourceIndex": 0
    },
    {
      "text": "// After",
      "sourceIndex": 0
    },
    {
      "text": "stripe.confirmCardPayment(clientSecret, {",
      "sourceIndex": 0
    },
    {
      "text": "payment_method: {",
      "sourceIndex": 0
    },
    {
      "text": "card: cardElement,",
      "sourceIndex": 0
    },
    {
      "text": "},",
      "sourceIndex": 0
    },
    {
      "text": "});",
      "sourceIndex": 0
    },
    {
      "text": "Replace confirmPaymentIntent with the more explicit confirmCardPayment.",
      "sourceIndex": 0
    },
    {
      "text": "javascript",
      "sourceIndex": 0
    },
    {
      "text": "// Before (deprecated)",
      "sourceIndex": 0
    },
    {
      "text": "stripe.confirmPaymentIntent(clientSecret, {",
      "sourceIndex": 0
    },
    {
      "text": "payment_method: {",
      "sourceIndex": 0
    },
    {
      "text": "card: cardElement,",
      "sourceIndex": 0
    },
    {
      "text": "},",
      "sourceIndex": 0
    },
    {
      "text": "});",
      "sourceIndex": 0
    },
    {
      "text": "// After",
      "sourceIndex": 0
    },
    {
      "text": "stripe.confirmCardPayment(clientSecret, {",
      "sourceIndex": 0
    },
    {
      "text": "payment_method: {",
      "sourceIndex": 0
    },
    {
      "text": "card: cardElement,",
      "sourceIndex": 0
    },
    {
      "text": "},",
      "sourceIndex": 0
    },
    {
      "text": "});",
      "sourceIndex": 0
    },
    {
      "text": "Replace handleFpxPayment with confirmFpxPayment, which has an identical API signature and behavior.",
      "sourceIndex": 0
    },
    {
      "text": "javascript",
      "sourceIndex": 0
    },
    {
      "text": "// Before (deprecated)",
      "sourceIndex": 0
    },
    {
      "text": "stripe.handleFpxPayment(clientSecret, {",
      "sourceIndex": 0
    },
    {
      "text": "payment_method: {",
      "sourceIndex": 0
    },
    {
      "text": "fpx: fpxBankElement,",
      "sourceIndex": 0
    },
    {
      "text": "},",
      "sourceIndex": 0
    },
    {
      "text": "});",
      "sourceIndex": 0
    },
    {
      "text": "// After",
      "sourceIndex": 0
    },
    {
      "text": "stripe.confirmFpxPayment(clientSecret, {",
      "sourceIndex": 0
    },
    {
      "text": "payment_method: {",
      "sourceIndex": 0
    },
    {
      "text": "fpx: fpxBankElement,",
      "sourceIndex": 0
    },
    {
      "text": "},",
      "sourceIndex": 0
    },
    {
      "text": "});",
      "sourceIndex": 0
    },
    {
      "text": "### Setup Intents API methods",
      "sourceIndex": 0
    },
    {
      "text": "Replace handleCardSetup with confirmCardSetup, which has a similar API signature and behavior.",
      "sourceIndex": 0
