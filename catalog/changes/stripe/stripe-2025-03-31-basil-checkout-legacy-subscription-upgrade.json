      "sourceIndex": 0
    },
    {
      "text": "# Using Sinatra",
      "sourceIndex": 0
    },
    {
      "text": "post '/webhook' do",
      "sourceIndex": 0
    },
    {
      "text": "payload = request.body.read",
      "sourceIndex": 0
    },
    {
      "text": "event = nil",
      "sourceIndex": 0
    },
    {
      "text": "begin",
      "sourceIndex": 0
    },
    {
      "text": "event = Stripe::Event.construct_from(",
      "sourceIndex": 0
    },
    {
      "text": "JSON.parse(payload, symbolize_names: true)",
      "sourceIndex": 0
    },
    {
      "text": ")",
      "sourceIndex": 0
    },
    {
      "text": "rescue JSON::ParserError => e",
      "sourceIndex": 0
