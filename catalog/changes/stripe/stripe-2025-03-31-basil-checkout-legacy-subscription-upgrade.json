      "sourceIndex": 0
    },
    {
      "text": "status 400",
      "sourceIndex": 0
    },
    {
      "text": "return",
      "sourceIndex": 0
    },
    {
      "text": "end",
      "sourceIndex": 0
    },
    {
      "text": "# Handle the event",
      "sourceIndex": 0
    },
    {
      "text": "case event.type",
      "sourceIndex": 0
    },
    {
      "text": "when 'payment_intent.succeeded'",
      "sourceIndex": 0
    },
    {
      "text": "payment_intent = event.data.object # contains a Stripe::PaymentIntent",
      "sourceIndex": 0
    },
    {
      "text": "# The subscription and invoice might not have been created at this stage.",
      "sourceIndex": 0
    },
    {
      "text": "# Then define and call a method to handle the successful payment intent.",
      "sourceIndex": 0
    },
    {
      "text": "# handle_payment_intent_succeeded(payment_intent)",
      "sourceIndex": 0
    },
    {
      "text": "when 'checkout_session.completed'",
      "sourceIndex": 0
    },
    {
      "text": "checkout_session = event.data.object # contains a Stripe::CheckoutSession",
      "sourceIndex": 0
    },
    {
      "text": "# checkout_session.payment_intent is a string here,",
      "sourceIndex": 0
    },
    {
      "text": "# but you can use this payment_intent token to fetch the associated invoice payment",
      "sourceIndex": 0
    },
    {
      "text": "# through the /v1/invoice_payments API method and its guaranteed associated invoice",
      "sourceIndex": 0
    },
    {
      "text": "# and invoice payment are non-null at this stage.",
      "sourceIndex": 0
    },
    {
      "text": "# Then define and call a method to handle the successful completion of a Checkout Session",
      "sourceIndex": 0
    },
    {
      "text": "# handle_checkout_session_completed(checkout_session)",
      "sourceIndex": 0
    },
    {
      "text": "# ... handle other event types",
      "sourceIndex": 0
    },
