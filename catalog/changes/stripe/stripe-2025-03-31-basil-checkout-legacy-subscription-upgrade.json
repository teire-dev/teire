  "kind": "behaviour-change",
  "title": "Checkout Sessions have lower latency and new update semantics",
  "summary": "This version offers improved latency on all Checkout Session APIs for subscription-mode Sessions, including when your customer confirms the Session. Because this change creates the subscription after the user has completed the payment, payment_intent doesn’t reference an invoice until the Checkout Session fully completes. This means the checkout.session.status property must be complete before the invoice is created.",
  "applicability": {
    "class": "breaks-on-upgrade",
    "fixedIn": [],
    "apiVersion": {
      "header": "Stripe-Version",
      "to": "2025-03-31.basil"
    },
    "announcedOn": "2025-03-31",
    "effectiveOn": null
  },
  "signatures": [],
  "replacement": null,
  "migrationNotes": [
    {
      "text": "Subscriptions are now created after the user completes payment.",
      "sourceIndex": 0
    },
    {
      "text": "Failed payment attempts no longer result in an incomplete subscription with a finalized invoice.",
      "sourceIndex": 0
    },
    {
      "text": "An invoice isn’t present until the Checkout Session is in the complete state.",
      "sourceIndex": 0
    },
    {
      "text": "#### Ruby",
      "sourceIndex": 0
    },
