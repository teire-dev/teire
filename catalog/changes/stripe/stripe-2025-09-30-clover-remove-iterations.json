  "title": "Removes iterations parameter for subscription schedules",
  "announcedOn": "2025-09-30",
  "effectiveOn": null,
  "breaking": true,
  "replacement": null,
  "extraction": {
    "method": "table"
  },
  "kind": "parameter-change",
  "summary": "We’ve removed the iterations parameter because duration replaces its functionality. We no longer support the iterations parameter for Subscription Schedules.",
  "signatures": {
    "modelIds": [],
    "params": ["iterations"],
    "endpoints": [],
    "symbols": ["iterations"],
