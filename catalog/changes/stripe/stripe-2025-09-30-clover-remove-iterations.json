  "kind": "parameter-change",
  "title": "Removes iterations parameter for subscription schedules",
  "summary": "We’ve removed the iterations parameter because duration replaces its functionality. We no longer support the iterations parameter for Subscription Schedules.",
  "applicability": {
    "class": "breaks-on-upgrade",
    "fixedIn": [],
    "apiVersion": {
      "header": "Stripe-Version",
      "to": "2025-09-30.clover"
    },
    "announcedOn": "2025-09-30",
    "effectiveOn": null
  },
  "signatures": [],
  "replacement": null,
  "migrationNotes": [
    {
      "text": "You must update your integration to use duration to specify the length of a subscription schedule phase in the following API endpoints:",
      "sourceIndex": 0
    },
    {
      "text": "Subscription Schedules Create",
      "sourceIndex": 0
    },
    {
      "text": "Subscription Schedules Update",
      "sourceIndex": 0
    },
    {
      "text": "Create an invoice preview",
      "sourceIndex": 0
    },
    {
      "text": "Using iterations in these endpoints now returns an error.",
      "sourceIndex": 0
    },
    {
      "text": "### Before",
      "sourceIndex": 0
    },
    {
      "text": "curl",
      "sourceIndex": 0
    },
    {
      "text": "curl https://api.stripe.com/v1/subscription_schedules \\",
      "sourceIndex": 0
    },
    {
      "text": "-u \"<<YOUR_SECRET_KEY>>:\" \\",
      "sourceIndex": 0
    },
    {
      "text": "-H \"Stripe-Version: 2025-08-27.basil\" \\",
      "sourceIndex": 0
    },
    {
      "text": "-d customer={{CUSTOMER_ID}} \\",
      "sourceIndex": 0
    },
    {
      "text": "-d start_date=now \\",
      "sourceIndex": 0
    },
    {
      "text": "-d \"phases[0][items][0][price]={{PRICE_PREMIUM}\" \\",
      "sourceIndex": 0
    },
    {
      "text": "-d \"phases[0][items][0][quantity]=1\" \\",
      "sourceIndex": 0
    },
    {
      "text": "-d \"phases[0][iterations]=3\" \\",
      "sourceIndex": 0
    },
    {
      "text": "-d end_behavior=release",
      "sourceIndex": 0
    },
    {
      "text": "### After",
      "sourceIndex": 0
    },
    {
      "text": "curl",
      "sourceIndex": 0
    },
    {
      "text": "curl https://api.stripe.com/v1/subscription_schedules \\",
      "sourceIndex": 0
    },
    {
      "text": "-u \"<<YOUR_SECRET_KEY>>:\" \\",
      "sourceIndex": 0
    },
    {
      "text": "-d customer={{CUSTOMER_ID}} \\",
      "sourceIndex": 0
    },
    {
      "text": "-d start_date=now \\",
      "sourceIndex": 0
    },
    {
      "text": "-d \"phases[0][items][0][price]={{PRICE_PREMIUM}\" \\",
      "sourceIndex": 0
    },
    {
      "text": "-d \"phases[0][items][0][quantity]=1\" \\",
      "sourceIndex": 0
    },
    {
      "text": "-d \"phases[0][duration][interval]=month\" \\",
      "sourceIndex": 0
    },
    {
      "text": "-d \"phases[0][duration][interval_count]=3\" \\",
      "sourceIndex": 0
    },
