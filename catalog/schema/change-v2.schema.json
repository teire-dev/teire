{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 2
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "subject": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["package", "api-host", "model", "runtime"]
        },
        "ecosystem": {
          "type": "string",
          "enum": ["npm", "pypi", "maven", "go", "cargo", "rubygems"]
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "provider": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        }
      },
      "required": ["kind", "name"]
    },
    "kind": {
      "type": "string",
      "enum": [
        "symbol-removed",
        "symbol-changed",
        "symbol-deprecated",
        "arity-changed",
        "required-added",
        "optional-to-required",
        "deep-import-removed",
        "feature-removed",
        "package-major",
        "package-deprecated",
        "package-yanked",
        "security-advisory",
        "model-retirement",
        "model-rerouted",
        "api-version-sunset",
        "parameter-change",
        "endpoint-removal",
        "behaviour-change",
        "runtime-eol",
        "account-gated"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "applicability": {
      "type": "object",
      "properties": {
        "class": {
          "type": "string",
          "enum": ["breaks-on-date", "breaks-on-upgrade", "already-broken", "security", "notice"]
        },
        "affectedRange": {
          "type": "string"
        },
        "fixedIn": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "fromVersion": {
          "type": "string"
        },
        "toVersion": {
          "type": "string"
        },
        "apiVersion": {
          "type": "object",
          "properties": {
            "header": {
              "type": "string"
            },
            "from": {
              "type": "string"
            },
            "to": {
              "type": "string"
            }
          }
        },
        "announcedOn": {
          "default": null,
          "anyOf": [
            {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "effectiveOn": {
          "default": null,
          "anyOf": [
            {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "environment": {
          "type": "object",
          "properties": {
            "markers": {
              "type": "string"
            },
            "cfg": {
              "type": "string"
            },
            "platform": {
              "type": "string"
            }
          }
        }
      },
      "required": ["class"]
    },
    "signatures": {
      "default": [],
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "symbol"
              },
              "lang": {
                "type": "string",
                "enum": ["ts", "py", "jvm", "go", "rust", "ruby"]
              },
              "declKey": {
                "type": "string",
                "minLength": 1
              },
              "path": {
                "type": "string",
                "minLength": 1
              },
              "memberKind": {
                "type": "string",
                "enum": [
                  "class",
                  "method",
                  "function",
                  "property",
                  "type",
                  "const",
                  "module",
                  "field",
                  "variable"
                ]
              },
              "before": {
                "type": "string"
              },
              "after": {
                "type": "string"
              },
              "arity": {
                "type": "object",
                "properties": {
                  "minBefore": {
                    "type": "integer",
                    "minimum": -9007199254740991,
                    "maximum": 9007199254740991
                  },
                  "maxBefore": {
                    "type": "integer",
                    "minimum": -9007199254740991,
                    "maximum": 9007199254740991
                  },
                  "minAfter": {
                    "type": "integer",
                    "minimum": -9007199254740991,
                    "maximum": 9007199254740991
                  },
                  "maxAfter": {
                    "type": "integer",
                    "minimum": -9007199254740991,
                    "maximum": 9007199254740991
                  }
                },
                "required": ["minBefore", "maxBefore", "minAfter", "maxAfter"]
              }
            },
            "required": ["kind", "lang", "declKey", "path", "memberKind"]
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "call-arg"
              },
              "callee": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "arg": {
                "type": "string",
                "minLength": 1
              },
              "position": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              }
            },
            "required": ["kind", "callee", "arg"]
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "string-literal"
              },
              "value": {
                "type": "string",
                "minLength": 1
              },
              "context": {
                "type": "string",
                "enum": ["llm-call-arg", "config", "any"]
              }
            },
            "required": ["kind", "value", "context"]
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "http-operation"
              },
              "method": {
                "type": "string",
                "minLength": 1
              },
              "pathPattern": {
                "type": "string",
                "minLength": 1
              },
              "hostPattern": {
                "type": "string",
                "minLength": 1
              },
              "operationId": {
                "type": "string"
              }
            },
            "required": ["kind", "method", "pathPattern", "hostPattern"]
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "import-path"
              },
              "value": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": ["kind", "value"]
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "cargo-feature"
              },
              "name": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": ["kind", "name"]
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "hash-key"
              },
              "key": {
                "type": "string",
                "minLength": 1
              },
              "calleeConstants": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": ["kind", "key", "calleeConstants"]
          }
        ]
      }
    },
    "replacement": {
      "default": null,
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "value": {
              "type": "string",
              "minLength": 1
            },
            "note": {
              "type": "string"
            },
            "modelIds": {
              "default": [],
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "codemod": {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "enum": ["rename", "model-swap", "kwarg-remove", "import-rewrite", "go-fix-inline"]
                },
                "spec": {}
              },
              "required": ["kind", "spec"]
            }
          },
          "required": ["value"]
        },
        {
          "type": "null"
        }
      ]
    },
    "migrationNotes": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1
          },
          "sourceIndex": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": ["text", "sourceIndex"]
      }
    },
    "sources": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "format": "uri"
          },
          "finalUrl": {
            "type": "string",
            "format": "uri"
          },
          "kind": {
            "type": "string",
            "enum": [
              "registry",
              "surface-diff",
              "advisory",
              "openapi-diff",
              "release-notes",
              "changelog",
              "migration-guide",
              "provider-table",
              "vendor-page",
              "repo-declared"
            ]
          },
          "trustBasis": {
            "type": "string",
            "enum": ["registry", "source-repo", "official-domain", "advisory-db", "computed", "repo-config"]
          },
          "quote": {
            "type": "string",
            "minLength": 1
          },
          "contentHash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "checkedAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
          },
          "tool": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "version": {
                "type": "string"
              }
            },
            "required": ["name", "version"]
          }
        },
        "required": ["url", "kind", "trustBasis", "contentHash", "checkedAt"]
      }
    },
    "provenance": {
      "type": "object",
      "properties": {
        "method": {
          "type": "string",
          "enum": ["tool", "table", "feed", "catalog", "model", "advisory-feed"]
        },
        "tool": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "version": {
              "type": "string"
            },
            "noiseFilterVersion": {
              "type": "string"
            }
          },
          "required": ["name", "version"]
        },
        "model": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "promptHash": {
              "type": "string"
            }
          },
          "required": ["id", "promptHash"]
        },
        "confidence": {
          "type": "object",
          "properties": {
            "overall": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "perField": {
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            }
          },
          "required": ["overall"]
        }
      },
      "required": ["method", "confidence"]
    },
    "visibility": {
      "type": "string",
      "enum": ["public", "private"]
    },
    "status": {
      "type": "string",
      "enum": ["confirmed", "candidate", "quarantined"]
    },
    "quarantineReasons": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "subject",
    "kind",
    "title",
    "summary",
    "applicability",
    "sources",
    "provenance",
    "visibility",
    "status"
  ]
}
