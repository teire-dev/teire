{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "homepage": {
      "type": "string",
      "format": "uri"
    },
    "logo": {
      "type": "object",
      "properties": {
        "light": {
          "type": "string",
          "minLength": 1
        },
        "dark": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": ["light", "dark"]
    },
    "officialDomains": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "sources": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "deprecations",
              "changelog",
              "release-feed",
              "model-catalog",
              "notices-index",
              "package-registry",
              "custom"
            ]
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "adapter": {
            "type": "string",
            "minLength": 1
          },
          "table": {
            "type": "object",
            "properties": {
              "sectionLevel": {
                "type": "integer",
                "minimum": 0,
                "maximum": 6
              },
              "subjectColumn": {
                "type": "string",
                "minLength": 1
              },
              "dateColumn": {
                "type": "string",
                "minLength": 1
              },
              "replacementColumn": {
                "type": "string",
                "minLength": 1
              },
              "skipSection": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": ["sectionLevel"],
            "additionalProperties": false
          }
        },
        "required": ["kind", "url", "adapter"]
      }
    },
    "sdks": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "ecosystem": {
            "type": "string",
            "enum": ["npm", "pypi", "go", "maven", "rubygems", "cargo"]
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "versions": {
            "type": "string"
          }
        },
        "required": ["ecosystem", "name"]
      }
    },
    "detection": {
      "type": "object",
      "properties": {
        "imports": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "envVars": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "baseUrls": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "calls": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "apiVersionHeader": {
      "type": "string"
    },
    "discovery": {
      "type": "object",
      "properties": {
        "at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
        },
        "via": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["llms.txt", "tavily", "probe", "teire.yml"]
          }
        },
        "query": {
          "type": "string"
        },
        "tavilyCredits": {
          "default": 0,
          "type": "number",
          "minimum": 0
        },
        "evidence": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": ["at", "via"]
    }
  },
  "required": ["schemaVersion", "slug", "name", "homepage", "logo", "officialDomains", "sources", "detection"]
}
