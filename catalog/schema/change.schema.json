{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "provider": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "kind": {
      "type": "string",
      "enum": [
        "model-retirement",
        "model-rerouted",
        "api-version-sunset",
        "parameter-change",
        "endpoint-removal",
        "sdk-major",
        "behaviour-change",
        "account-gated"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "announcedOn": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "effectiveOn": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "breaking": {
      "type": "boolean"
    },
    "signatures": {
      "type": "object",
      "properties": {
        "modelIds": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "params": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "endpoints": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "symbols": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "packages": {
          "default": [],
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "ecosystem": {
                "type": "string",
                "enum": ["npm", "pypi"]
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "versions": {
                "type": "string"
              }
            },
            "required": ["ecosystem", "name"]
          }
        },
        "apiVersions": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "replacement": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "value": {
              "type": "string",
              "minLength": 1
            },
            "note": {
              "type": "string"
            },
            "modelIds": {
              "default": [],
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": ["value"]
        },
        {
          "type": "null"
        }
      ]
    },
    "migrationNotes": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "sources": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "format": "uri"
          },
          "quote": {
            "type": "string",
            "minLength": 1
          },
          "contentHash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "checkedAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
          }
        },
        "required": ["url", "quote", "contentHash", "checkedAt"]
      }
    },
    "extraction": {
      "type": "object",
      "properties": {
        "method": {
          "type": "string",
          "enum": ["table", "feed", "catalog", "model"]
        },
        "model": {
          "type": "string"
        }
      },
      "required": ["method"]
    },
    "status": {
      "type": "string",
      "enum": ["confirmed", "quarantined"]
    },
    "quarantineReasons": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "provider",
    "kind",
    "title",
    "summary",
    "announcedOn",
    "effectiveOn",
    "breaking",
    "signatures",
    "replacement",
    "sources",
    "extraction",
    "status"
  ]
}
