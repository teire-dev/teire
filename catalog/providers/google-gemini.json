{
  "schemaVersion": 1,
  "slug": "google-gemini",
  "name": "Google Gemini",
  "homepage": "https://ai.google.dev/gemini-api/docs",
  "logo": {
    "light": "/logos/gemini.svg",
    "dark": "/logos/gemini.svg"
  },
  "officialDomains": ["ai.google.dev"],
  "sources": [
    {
      "kind": "deprecations",
      "url": "https://ai.google.dev/gemini-api/docs/deprecations.md.txt",
      "adapter": "deprecation-table",
      "table": {
        "sectionLevel": 2
      }
    }
  ],
  "sdks": [
    {
      "ecosystem": "npm",
      "name": "@google/genai"
    },
    {
      "ecosystem": "npm",
      "name": "@google/generative-ai"
    },
    {
      "ecosystem": "npm",
      "name": "@ai-sdk/google"
    },
    {
      "ecosystem": "npm",
      "name": "@langchain/google-genai"
    },
    {
      "ecosystem": "pypi",
      "name": "google-genai"
    },
    {
      "ecosystem": "pypi",
      "name": "google-generativeai"
    },
    {
      "ecosystem": "go",
      "name": "google.golang.org/genai"
    },
    {
      "ecosystem": "maven",
      "name": "com.google.genai:google-genai"
    }
  ],
  "detection": {
    "imports": [
      "@google/genai",
      "@google/generative-ai",
      "@ai-sdk/google",
      "@langchain/google-genai",
      "google.genai",
      "google.generativeai",
      "langchain_google_genai"
    ],
    "envVars": ["GEMINI_API_KEY", "GOOGLE_API_KEY"],
    "baseUrls": ["generativelanguage.googleapis.com"],
    "calls": [
      "models.generate_content",
      "models.generate_content_stream",
      "models.count_tokens",
      "models.embed_content",
      "models.generateContent",
      "models.generateContentStream",
      "models.countTokens",
      "models.embedContent",
      "getGenerativeModel",
      "GenerativeModel"
    ]
  }
}
