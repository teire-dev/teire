[
 {
  "name": "negative: every version ignored (security job)",
  "repo": "teire-dev/serve-handler",
  "manager": "yarn",
  "ecosystem": "npm",
  "roots": [
   "."
  ],
  "shape": {
   "kind": "security",
   "dependency": "minimatch",
   "advisories": [
    {
     "dependencyName": "minimatch",
     "affectedVersions": [
      "< 99.0.0"
     ],
     "patchedVersions": [
      ">= 99.0.0"
     ],
     "unaffectedVersions": []
    }
   ]
  },
  "ignore": [
   {
    "dependencyName": "minimatch"
   }
  ],
  "expect": {
   "kind": "stop",
   "type": "all_versions_ignored"
  }
 },
